#!/usr/bin/env -S bashy --bashsharp
# Grammar-oracle generation unit (Sprint 384, #1586). Runs only on the claimed
# remote host, driven by gen/generate.sh; never on the development machine.
#
#   generate.bsh OUT     (cwd: the go-target grammar directory)
#
# java-runner must already be registered (generate.sh does it in a private
# BASHY_COMMANDS_DIR ring). CLASSPATH and JAVA_RUNNER_CLASSPATH both name the
# verified antlr-4.13.2-complete.jar: javac resolves org.antlr.v4.Tool through
# CLASSPATH, the run through JAVA_RUNNER_CLASSPATH. Grammar files are passed by
# bare name so the "Code generated from X.g4" headers do not carry a temp path.

~~~java as gen !java-runner
public class Gen {
    public static void main(String[] args) {
        System.err.println("gen: java.version=" + System.getProperty("java.version")
            + " java.vendor=" + System.getProperty("java.vendor")
            + " antlr=" + org.antlr.v4.Tool.VERSION);
        org.antlr.v4.Tool.main(args);
    }
}
~~~

out="$1"
gen.main("-Dlanguage=Go", "-no-listener", "-no-visitor", "-package", "goparser", "-Xexact-output-dir", "-o", "$out", "GoLexer.g4", "GoParser.g4")
