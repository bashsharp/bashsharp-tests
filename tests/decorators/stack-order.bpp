#!/usr/bin/env bashy
# bash++ profile: decorators · phase S197 · status: planned
#
# Reference: CPython test_decorators.py test_order and the language-reference
# equivalence @f1 @f2 def f ≡ f1(f2(f)) — the decorator nearest the
# declaration is innermost, the stack executes outermost-first.
# dhnt difference: the stack is a chain of `c *Call` frames; no function
# object is replaced.

func outer(c *Call) {
    echo "outer:enter"
    c.Next()
    echo "outer:exit"
}

func inner(c *Call) {
    echo "inner:enter"
    c.Next()
    echo "inner:exit"
}

@outer()
@inner()
func target() {
    echo "target:body"
}

target()
