#!/usr/bin/env bashy
// run
# bash++ profile: decorators · phase S197 · status: supported
#
# Layout is grammar: the decorator must retain its association across a
# semicolon, stacked decorators, and a comment. The semicolon is required
# when the declaration shares the decorator's line.

@n(); func semicolonDecorated() {}

@outer()
@inner()
func stackedDecorated() {}

@n()
# association survives a comment-only line
func commentDecorated() {}
