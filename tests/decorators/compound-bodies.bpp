#!/usr/bin/env bashy
// errorcheck
// ERROR "decorator.*declaration"
# bash++ profile: decorators · phase S197 · status: planned
#
# A decorator cannot target a Bash compound command. The eventual diagnostic
# must direct users to a declaration, while the shell parser retains ordinary
# compound commands outside this decorator-shaped prefix.

@n()
{ :; }

@n()
( : )

@n()
for x in one; do :; done

@n()
case x in x) :;; esac

@n()
if :; then :; fi

@n()
while :; do :; done

@n()
until :; do :; done
