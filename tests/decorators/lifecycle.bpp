#!/usr/bin/env bashy
# bash++ profile: decorators · phase S197 · status: planned
#
# defer/panic/recover lifecycle through decorator frames.

func catch(c *Call) {
    defer func() {
        if r := recover(); r != nil {
            echo "caught:[$r]"
            c.Status = 1
        }
    }()
    c.Next()
}

@catch()
func panic_maker() {
    defer echo "defer:body"
    panic("boom")
}

panic_maker
echo "status:[$?]"
