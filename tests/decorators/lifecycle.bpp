#!/usr/bin/env bashy
# bash++ profile: decorators · phase S197 · status: planned
#
# defer/panic/recover lifecycle through decorator frames.

func catch(c *Call) {
    defer func() {
        r := recover()
        echo "caught:[$r]"
        c.Status = 1
    }()
    c.Next()
}

func cleanup() { echo "defer:body" }

@catch()
func panic_maker() {
    defer cleanup()
    panic("boom")
}

panic_maker()
echo "status:[$?]"
