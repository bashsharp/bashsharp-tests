def main() -> int:
    _ = None
    def _show(value):
        nonlocal _
        if value is not None:
            print(repr(value))
            _ = value
    def _input(prompt, response):
        print(prompt + response)
        return response
    def _exception(error, line):
        print(line)
    def _syntax(source, line):
        try:
            compile(source, '<stdin>', 'single')
        except BaseException as error:
            _exception(error, line)
    # Doc/tutorial/modules.rst:28-46
    def fib(n):
        """Write Fibonacci series up to n."""
        a, b = (0, 1)
        while a < n:
            print(a, end=' ')
            a, b = (b, a + b)
        print()

    def fib2(n):
        """Return Fibonacci series up to n."""
        result = []
        a, b = (0, 1)
        while a < n:
            result.append(a)
            a, b = (b, a + b)
        return result
    import sys
    import types
    fibo = types.ModuleType('fibo')
    fibo.fib = fib
    fibo.fib2 = fib2
    sys.modules['fibo'] = fibo
