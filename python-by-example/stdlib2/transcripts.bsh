def main() -> int:
    _ = None
    def _show(value):
        nonlocal _
        if value is not None:
            print(repr(value))
            _ = value
    def _input(prompt, response):
        print(prompt + response)
        return response
    def _exception(error, line):
        print(line)
    def _syntax(source, line):
        try:
            compile(source, '<stdin>', 'single')
        except BaseException as error:
            _exception(error, line)
